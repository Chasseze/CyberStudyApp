rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validEntry() {
      return request.resource.data.week is string
        && request.resource.data.week.size() > 0
        && request.resource.data.week.size() <= 80
        && request.resource.data.topic is string
        && request.resource.data.topic.size() > 0
        && request.resource.data.topic.size() <= 200
        && request.resource.data.goal is string
        && request.resource.data.goal.size() > 0
        && request.resource.data.goal.size() <= 500;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Entries: /entries/{userId}/data/{entryId}
    match /entries/{userId}/data/{entryId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validEntry();
      allow delete: if isOwner(userId);
    }
    
    // Goals: /goals/{userId}/data/{goalId}
    match /goals/{userId}/data/{goalId} {
      allow read, write: if isOwner(userId);
    }
    
    // Timer Sessions: /timerSessions/{userId}/data/{sessionId}
    match /timerSessions/{userId}/data/{sessionId} {
      allow read, write: if isOwner(userId);
    }
    
    // Streaks: /streaks/{userId}/data/{document}
    match /streaks/{userId}/data/{document} {
      allow read, write: if isOwner(userId);
    }
  }
}
