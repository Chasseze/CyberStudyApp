# Demo Mode Configuration (No Firebase Required)
# Set this to 'true' to run the app in demo mode without Firebase

VITE_DEMO_MODE=true

# When DEMO_MODE is true, the app will:
# - Skip Firebase authentication
# - Use localStorage only (no cloud sync)
# - Show a demo banner
# - Allow full functionality testing

# To use Firebase later, set DEMO_MODE=false and add Firebase credentials